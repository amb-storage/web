# Copy lên server: /amb-storage-web/.env.production (chủ sở hữu root, chmod 600).
# File này vừa là --env-file cho docker compose, vừa là env_file của container web.

# Image đang chạy; CD tự cập nhật dòng này sau mỗi lần deploy (giữ đúng 1 dòng).
AMB_STORAGE_WEB_IMAGE=amb-storage-web:initial

# Backend gọi qua mạng nội bộ amb-network (container API của project amb-storage-prod, port 8000).
# Dùng cả lúc build (rewrite /api/v1/*) và lúc chạy (server component).
API_BASE_URL=http://amb-storage-prod-api-1:8000
